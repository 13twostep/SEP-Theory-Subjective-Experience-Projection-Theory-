if __name__ == "__main__":
    API_KEY = os.environ.get("GEMINI_API_KEY", "ここに_API_KEY_を入力")
    
    if API_KEY == "ここに_API_KEY_を入力" or not API_KEY:
        print("エラー: Gemini APIキーが設定されていません。")
    else:
        print("=== 9BEE2 - Aufheben Engine 起動 ===")
        bot = SEP_Aufheben_IntegratedMind(api_key=API_KEY)
        
        while True:
            try:
                user_input = input("\n💬 [YOU]: ")
